{
  "name": "devops-daily",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.1 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "pnpm images:all && pnpm copy:markdown && pnpm generate-search-index && pnpm generate-feed && pnpm generate-devto-feed && next build && pnpm copy:markdown:out",
    "build:fast": "pnpm copy:markdown && pnpm generate-search-index && pnpm generate-feed && pnpm generate-devto-feed && next build && pnpm copy:markdown:out",
    "build:cf": "pnpm copy:markdown && pnpm generate-search-index && pnpm generate-feed && pnpm generate-devto-feed && next build && pnpm copy:markdown:out",
    "build:images": "pnpm images:all",
    "build:images:force": "pnpm generate:images -- --force && pnpm convert:svg-to-png -- --force && pnpm prune:svgs",
    "export": "next build && next export",
    "copy:markdown": "node scripts/copy-markdown.cjs",
    "copy:markdown:out": "node scripts/copy-markdown-to-out.cjs",
    "generate-feed": "tsx scripts/generate-feed.ts",
    "generate-devto-feed": "tsx scripts/generate-devto-feed.ts",
    "generate:images": "tsx scripts/generate-content-og.ts",
    "generate:images:preview": "tsx scripts/generate-content-og.ts --preview --force",
    "regenerate:content-covers": "pnpm generate:images -- --force && pnpm prune:svgs && pnpm validate:images",
    "validate:images": "tsx scripts/generate-content-og.ts --check",
    "convert:svg-to-png": "tsx scripts/convert-svg-to-png-parallel.ts",
    "start": "next start",
    "lint": "eslint app components hooks lib scripts tests --cache --cache-location .cache/eslint",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "quiz:validate": "tsx scripts/quiz-dev.ts validate",
    "quiz:create": "tsx scripts/quiz-dev.ts create",
    "quiz:list": "tsx scripts/quiz-dev.ts list",
    "quiz:stats": "tsx scripts/quiz-dev.ts stats",
    "generate-quiz-og": "tsx scripts/generate-quiz-og.ts",
    "svg2png": "tsx scripts/svg-to-png.ts",
    "images:all": "pnpm generate:images && pnpm convert:svg-to-png && pnpm prune:svgs",
    "prune:svgs": "tsx scripts/prune-deploy-svgs.ts --execute",
    "generate-search-index": "tsx scripts/generate-search-index.ts",
    "validate:games": "tsx scripts/validate-game-registry.ts",
    "devops-daily:generate-news": "tsx scripts/devops-daily/index.ts",
    "devops-daily:generate-news:no-ai": "tsx scripts/devops-daily/index.ts --skip-ai",
    "og:newsletters": "tsx scripts/generate-newsletter-og.ts",
    "og:validate": "tsx scripts/git-hooks/validate-og-data.ts",
    "og:validate:staged": "tsx scripts/git-hooks/validate-og-data.ts --staged-only",
    "hooks:install": "sh scripts/git-hooks/install.sh",
    "check-links": "node --import tsx scripts/check-broken-links.ts",
    "check-internal-links": "tsx scripts/check-internal-links.ts",
    "audit-content": "tsx scripts/audit-content.ts",
    "generate:readme-sponsors": "tsx scripts/generate-readme-sponsors.ts"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@next/third-parties": "^16.3.5",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "input-otp": "1.5.0",
    "js-yaml": "^5.4.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "openai": "^7.19.0",
    "react": "^19.3.0",
    "react-confetti": "^6.4.0",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "7.3.5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "postcss@<8.5.23": "^8.5.23",
      "undici@7": "^7.29.0",
      "browserslist": "^4.28.7",
      "sharp@<0.35.0": "^0.35.3"
    }
  }
}

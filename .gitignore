# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
bun.lock

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.cache/

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json

# generated static markdown files
/public/posts/
/public/guides/
/public/advent-of-devops/
/public/comparisons/

# local/editor backup files
*.orig
.claude/scheduled_tasks.lock

# skill eval workspace
skill-eval-workspace/

# Generated at build time by scripts/generate-section-sitemaps.ts. Committing
# them means a stale snapshot sitting next to the real thing.
# Globbed rather than listed, so adding a section does not need a second edit
# here. Does not match /public/sitemap.xml, which has no hyphen.
/public/sitemap-*.xml
